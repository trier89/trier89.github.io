{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{/* 2026-07-28 SEO: 얇은 태그/카테고리 목록페이지(noindex 처리됨)는 sitemap에서 제외 → 실콘텐츠만 크롤 유도 */}}
  {{/* 2026-08-01 애드센스: 자동생성 데일리 글(뉴스·역사·트렌드·작업로그)도 sitemap 제외 → 실콘텐츠만 심사·크롤 유도 */}}
  {{ $auto := slice "뉴스" "오늘의 역사" "트렌드" "검색 트렌드" }}
  {{ range .Data.Pages }}
    {{ $isAuto := or (intersect (.Params.categories | default slice) $auto) (eq .Section "darak-company-log") }}
    {{ if and .Permalink (ne .Kind "taxonomy") (ne .Kind "term") (not $isAuto) }}
    <url>
      <loc>{{ .Permalink }}</loc>
      {{ if not .Lastmod.IsZero }}<lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
      {{ with .Sitemap.ChangeFreq }}<changefreq>{{ . }}</changefreq>{{ end }}
      {{ if ge .Sitemap.Priority 0.0 }}<priority>{{ .Sitemap.Priority }}</priority>{{ end }}
    </url>
    {{ end }}
  {{ end }}
</urlset>
