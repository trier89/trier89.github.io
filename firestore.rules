rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 댓글 · 요청방: 익명 인증만 허용, 생성만(수정·삭제 금지), 필드·크기 검증
    match /comments/{id} {
      allow read: if true;                        // 공개 읽기(댓글 표시용)
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['page','nick','text','uid','ts'])
                    && request.resource.data.nick is string
                    && request.resource.data.nick.size() >= 1
                    && request.resource.data.nick.size() <= 20
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 300;
      allow update: if false;                     // 수정 금지
      // 삭제: 본인이 작성한 댓글만(익명 uid 일치). 남의 댓글 삭제 불가.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // 게임 리더보드: 익명 인증만 생성 허용(수정·삭제 금지), 필드·크기·타입 검증
    match /scores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['game','nick','score','uid','ts'])
        && request.resource.data.game is string && request.resource.data.game.size() <= 30
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 20
        && request.resource.data.score is number;
      allow update, delete: if false;
    }

    // 그 외 모든 경로 완전 차단(백스톱)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
