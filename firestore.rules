rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 댓글 · 요청방: 익명 인증만 허용, 생성만(수정·삭제 금지), 필드·크기 검증
    match /comments/{id} {
      allow read: if true;                        // 공개 읽기(댓글 표시용)
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['page','nick','text','uid','ts','parent'])
                    && request.resource.data.nick is string
                    && request.resource.data.nick.size() >= 1
                    && request.resource.data.nick.size() <= 20
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 1
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.page is string
                    && request.resource.data.page.size() <= 300
                    // 대댓글: parent = 부모 댓글 id('' = 최상위). 하위호환 위해 선택적(구버전 클라이언트=parent 없음도 허용)
                    && (!('parent' in request.resource.data)
                        || (request.resource.data.parent is string && request.resource.data.parent.size() <= 64));
      allow update: if false;                     // 수정 금지
      // 삭제: 본인이 작성한 댓글만(익명 uid 일치). 남의 댓글 삭제 불가.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // 게임 리더보드: 익명 인증만 생성 허용(수정·삭제 금지), 필드·크기·타입 검증
    match /scores/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['game','nick','score','uid','ts'])
        && request.resource.data.game is string && request.resource.data.game.size() <= 30
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 20
        && request.resource.data.score is number;
      allow update, delete: if false;
    }

    // 화장실 평가/리뷰: 익명 인증 생성, 필드·크기 검증, 본인것만 삭제
    match /toilet_reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['tid','rating','text','nick','uid','ts','paper'])
        && request.resource.data.tid is string && request.resource.data.tid.size() <= 64
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 200
        && request.resource.data.nick is string && request.resource.data.nick.size() >= 1 && request.resource.data.nick.size() <= 16
        && (!('paper' in request.resource.data) || request.resource.data.paper is bool);
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 고유 계정 프로필: 본인만 생성·수정, 읽기 공개(리뷰 국적/성별 표시용)
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['userid','nationality','gender','ts'])
        && request.resource.data.userid is string && request.resource.data.userid.size() >= 2 && request.resource.data.userid.size() <= 16
        && request.resource.data.nationality is string && request.resource.data.nationality.size() <= 40
        && request.resource.data.gender is string && request.resource.data.gender.size() <= 2;
      allow delete: if request.auth != null && uid == request.auth.uid;
    }
    // 아이디 유일성 예약: 없을 때만 생성(update·delete 금지 → 선점 불가)
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','ts']);
      allow update: if false;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 그 외 모든 경로 완전 차단(백스톱)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
